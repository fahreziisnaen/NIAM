# ==============================================================================
# Phillip Securities Hong Kong – Network Asset Management System (.env)
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=PhillipPostgres2026!
POSTGRES_DB=phillip_assets

# Database connection URL (for local bare-metal run; Docker Compose generates its own)
DATABASE_URL=postgresql://postgres:PhillipPostgres2026!@localhost:5432/phillip_assets

# JWT Security & Session
SECRET_KEY=phillip-securities-hk-super-secret-key-2026-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Directory
UPLOAD_DIR=/app/uploads

# Frontend Internal Reverse Proxy (used by Next.js in Docker Compose)
INTERNAL_BACKEND_URL=http://backend:8000

# Optional Public API URL override (leave empty to use Next.js internal reverse proxy)
NEXT_PUBLIC_API_URL=

# ==============================================================================
# Production vs Demo Configuration
# ==============================================================================
# Environment:
#   production = Production mode (hides demo badges, enforces strict security)
#   demo       = Demonstration mode with quick-fill sample buttons
APP_ENV=production

# SEED_DEMO_DATA:
#   true  = Populates realistic demo assets, contracts, and topology links
#   false = Pristine, clean production database (zero mock assets; only Super Admin, roles, categories, rules)
SEED_DEMO_DATA=false

# SHOW_DEMO_CREDENTIALS:
#   true  = Displays quick-fill demo buttons on the login page
#   false = Hides all demo credentials and info on the login page (production clean login)
SHOW_DEMO_CREDENTIALS=false

# Initial Super Admin Account (used on first-time database seed):
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=GantiPasswordKuatAnda2026!
INITIAL_ADMIN_EMAIL=noc@phillip.com.hk
INITIAL_ADMIN_FULL_NAME=Administrator
