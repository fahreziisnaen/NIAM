# ==============================================================================
# Phillip Securities Hong Kong – Enterprise Asset Management (.env)
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=PhillipPostgres2026!
POSTGRES_DB=phillip_assets

# Database connection URL (for local bare-metal run; Docker Compose generates its own)
DATABASE_URL=postgresql://postgres:PhillipPostgres2026!@localhost:5432/phillip_assets

# JWT Security & Session
SECRET_KEY=phillip-securities-hk-super-secret-key-2026-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Directory
UPLOAD_DIR=/app/uploads

# Frontend Internal Reverse Proxy (used by Next.js in Docker Compose)
INTERNAL_BACKEND_URL=http://backend:8000

# Optional Public API URL override (leave empty to use Next.js internal reverse proxy)
NEXT_PUBLIC_API_URL=
